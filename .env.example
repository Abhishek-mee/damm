# Copy this file to .env.local and fill in your key.
# .env.local is gitignored. NEVER commit a real key.

# Required: OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional: default model override. Individual agents set their own models.
# See the agent files in .opencode/agents/ for the current assignments.
OPENROUTER_MODEL=thinkingmachines/inkling:free

# Optional: OpenRouter attribution headers
OPENROUTER_SITE_URL=https://github.com/Abhishek-mee/damm
OPENROUTER_APP_NAME=DAMM

# Optional: Langfuse tracing (only needed if you enable Langfuse later)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000
